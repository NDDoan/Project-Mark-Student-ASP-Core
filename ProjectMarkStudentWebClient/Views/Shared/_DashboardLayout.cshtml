@section Scripts {
    <script>
        function logout() {
            localStorage.removeItem("jwtToken");
            window.location.href = "/Auth/Login";
        }

        /* ===== THEME ENGINE ===== */
        function applyTheme(preference) {
            const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
            const resolved = preference === 'system' ? (prefersDark ? 'dark' : 'light') : preference;
            document.documentElement.setAttribute('data-theme', resolved);
            localStorage.setItem('dashboardTheme', preference);
            const sel = document.getElementById('theme-select');
            if (sel) sel.value = preference;
        }

        // Init on load
        (function () {
            const saved = localStorage.getItem('dashboardTheme') || 'dark';
            applyTheme(saved);
        })();

        // Watch system preference changes
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function () {
            const current = localStorage.getItem('dashboardTheme') || 'dark';
            if (current === 'system') applyTheme('system');
        });

        document.addEventListener('DOMContentLoaded', function () {
            const sel = document.getElementById('theme-select');
            if (sel) {
                sel.addEventListener('change', function () { applyTheme(this.value); });
            }
        });

        $(document).ready(function () {
            const auth = getAuthInfo();
            if (!auth) {
                window.location.href = "/Auth/Login";
                return;
            }

            const lowerRole = auth.role ? auth.role.toLowerCase() : "";

            if (lowerRole.includes("admin")) {
                $(".role-admin").show();
                $("#sidebarTitle").text("Admin Panel");
                $("#userRoleBadge").text("Admin").removeClass().addClass("avatar-role-badge badge-admin");
                loadAvatarInfo(auth.role);
            } else if (lowerRole.includes("quản lý") || lowerRole.includes("quan ly") || lowerRole.includes("manager") || lowerRole.includes("qun ly")) {
                $(".role-manager").show();
                $("#sidebarTitle").text("Manager Panel");
                $("#userRoleBadge").text("Quản lý").removeClass().addClass("avatar-role-badge badge-manager");
                loadAvatarInfo(auth.role);
            } else if (lowerRole.includes("giáo viên") || lowerRole.includes("giao vien") || lowerRole.includes("teacher") || lowerRole.includes("viên") || lowerRole.includes("vien") || lowerRole.includes("vin")) {
                $(".role-teacher").show();
                $("#sidebarTitle").text("Teacher Panel");
                $("#userRoleBadge").text("Giáo viên").removeClass().addClass("avatar-role-badge badge-teacher");
                loadAvatarInfo(auth.role);
            }

            function loadAvatarInfo(roleName) {
                $("#userAvatarSection").show();
                $.ajax({
                    url: apiUrl + "/Users/me",
                    type: "GET",
                    headers: { "Authorization": "Bearer " + localStorage.getItem("jwtToken") },
                    success: function (data) {
                        const fullName = ((data.lastName || "") + " " + (data.firstName || data.username)).trim();
                        $("#userFullName").text(fullName);
                        const initial = data.firstName ? data.firstName.charAt(0) : (data.username ? data.username.charAt(0) : "U");
                        if (data.avatarUrl) {
                            $("#userAvatar").attr("src", data.avatarUrl);
                        } else {
                            $("#userAvatar").attr("src", `https://ui-avatars.com/api/?name=${encodeURIComponent(initial)}&background=6366f1&color=fff&size=80&rounded=true`);
                        }
                    }
                });
            }

            $("#app-section").show();

            // Highlight active nav item
            const currentPath = window.location.pathname.toLowerCase();
            $(".nav-item a").each(function () {
                if ($(this).attr("href").toLowerCase() === currentPath) {
                    $(this).closest(".nav-item").addClass("active");
                }
            });
        });
    </script>
    @await RenderSectionAsync("DashboardScripts", required: false)
}
